{
  // Shared compiler rules for both sides of the tool. Mirrors
  // SaySolid/server/tsconfig.base.json (strict, exact optional props, no
  // unchecked index access) plus the ".ts import extension" convention that
  // tsx, Vite and Vitest all understand at runtime (see CONTRACTS.md).
  //
  // Only `include` and the side-specific options (module resolution, lib, jsx,
  // types) live in tsconfig.json / tsconfig.web.json.
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  }
}
